# Application
APP_NAME=PROVE
APP_ENV=development
DEBUG=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=prove

# Auth (generate a secure random string for production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Beta limits
MAX_BETA_USERS=10

# LLM (required in production; optional in development)
LLM_API_KEY=

# Verification policy
VERIFICATION_APTITUDE_MAX_RETRIES=2
VERIFICATION_CODING_MAX_RETRIES=2
CACHE_TTL_TECHNICAL_DAYS=180
CACHE_TTL_JOB_POSTING_DAYS=90
CACHE_TTL_QUESTION_REVERIFY_DAYS=90
